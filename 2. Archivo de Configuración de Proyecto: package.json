{
  "name": "securenode-solutions-testing",
  "version": "1.0.0",
  "scripts": {
    "start": "expo start",
    "test": "jest"
  },
  "dependencies": {
    "expo": "~50.0.0",
    "expo-camera": "~14.1.1",
    "expo-location": "~16.5.5",
